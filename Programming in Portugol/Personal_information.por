algoritmo "Personal information"

var
  nome : caractere
  idade : inteiro
  salario : real

inicio
  escreva ("qual seu nome?")
  leia (nome)

  escreva ("qual a sua idade?")
  leia (idade)

  escreva ("quanto voce ganha de salario?")
  leia (salario)

  escreva ("olá, ", nome, "! ")
  escreva ("sua idade é  ", idade)
  escreva (" e voce ganha $", salario)
fimalgoritmo
